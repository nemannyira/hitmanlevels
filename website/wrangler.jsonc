// hitmanlevels.com: the pages (public/) and the API (src/worker.js) in one Worker (docs/site_api.md)
{
  "name": "hitmanlevels",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/levels/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "hitmanlevels", "database_id": "fc6394a6-ff82-499e-85e9-045661de42e6", "migrations_dir": "migrations" }
  ],
  // every day at 03:17 UTC: old reports and ended sessions deleted (src/worker.js cleanUp, privacy.html)
  "triggers": { "crons": ["17 3 * * *"] },
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "hitmanlevels" }
  ],
  "vars": {
    "SITE_ORIGIN": "https://hitmanlevels.com",
    // the OAuth apps "Hitman Levels" (not secret; docs/site_api.md)
    "DISCORD_CLIENT_ID": "1570820906547290173",
    "GITHUB_CLIENT_ID": "Ov23liUlIvU893HmojPP",
    "GOOGLE_CLIENT_ID": "829125191265-uutq5bq60gojb0vdajn0kk7c75oskhb7.apps.googleusercontent.com"
  }
  // secrets (wrangler secret put; .dev.vars for wrangler dev): SITE_SEED (the list's Ed25519 key, 64 hex),
  // DISCORD_CLIENT_SECRET, GITHUB_CLIENT_SECRET, GOOGLE_CLIENT_SECRET
}
