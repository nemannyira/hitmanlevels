// hitmanlevels.com: the pages (public/) and the API (src/worker.js) in one Worker (docs/site_api.md)
{
  "name": "hitmanlevels",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/levels/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "hitmanlevels", "database_id": "local-only-until-created", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "hitmanlevels" }
  ],
  "vars": {
    "SITE_ORIGIN": "https://hitmanlevels.com"
  }
  // secrets (wrangler secret put; .dev.vars for wrangler dev): SITE_SEED (the list's Ed25519 key, 64 hex),
  // DISCORD_CLIENT_ID, DISCORD_CLIENT_SECRET, GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET, GOOGLE_CLIENT_ID,
  // GOOGLE_CLIENT_SECRET
}
